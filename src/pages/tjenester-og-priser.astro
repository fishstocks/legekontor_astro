---
import BaseLayout from '../layouts/BaseLayout.astro';
import { priceList } from '../data/clinic';
---

<BaseLayout
  title="Priser | Vågsbygd legesenter"
  description="Oversikt over egenandeler og andre vanlige priser ved Vågsbygd legesenter."
>
  <section class="section price-list-section" aria-labelledby="prices-heading">
    <div class="shell">
      <header class="price-list-header">
        <div>
          <p class="eyebrow">Offisiell prisliste</p>
          <h1 id="prices-heading">Priser hos fastlegen</h1>
          <p class="price-list-header__period">
            Gjeldende fra {priceList.validFrom} til {priceList.validThrough}
          </p>
        </div>
        <div class="price-list-header__intro">
          <p>
            Hva du betaler avhenger av kontakttype, tidspunkt og hvilke
            undersøkelser eller materialer som brukes. Har du frikort, betaler
            du ikke egenandeler som inngår i frikortgrunnlaget.
          </p>
          <a
            class="button button--secondary"
            href={priceList.sourceUrl}
            target="_blank"
            rel="noreferrer"
          >
            Se offisiell takstplakat
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </header>

      <aside class="price-frikort" aria-labelledby="price-frikort-heading">
        <svg aria-hidden="true" viewBox="0 0 48 48">
          <ellipse cx="15" cy="11" rx="9" ry="4"></ellipse>
          <path d="M6 11v8c0 2.2 4 4 9 4s9-1.8 9-4v-8"></path>
          <path d="M6 19v8c0 2.2 4 4 9 4 2.2 0 4.2-.4 5.8-1"></path>
          <ellipse cx="33" cy="23" rx="9" ry="4"></ellipse>
          <path d="M24 23v8c0 2.2 4 4 9 4s9-1.8 9-4v-8"></path>
          <path d="M24 31v6c0 2.2 4 4 9 4s9-1.8 9-4v-6"></path>
        </svg>
        <div>
          <p class="eyebrow">Frikort i 2026</p>
          <h2 id="price-frikort-heading">Egenandelstaket er 3 278 kr</h2>
          <p>
            Når du har betalt over egenandelstaket i godkjente egenandeler,
            får du normalt frikort automatisk.
          </p>
        </div>
        <a href="/praktisk-informasjon/#frikort">
          <span>Les om frikort</span><span aria-hidden="true">→</span>
        </a>
      </aside>

      <div class="price-groups">
        {
          priceList.groups.map((group) => (
            <article
              class:list={[
                'price-group',
                `price-group--${group.tone}`,
              ]}
            >
              <header class="price-group__header">
                <h3>{group.title}</h3>
                <p>{group.description}</p>
              </header>
              <dl class="price-rows">
                {group.items.map((item) => (
                  <div class="price-row">
                    <dt>{item.label}</dt>
                    <dd>
                      <strong>{item.amount}</strong>
                      {item.amountContext && <span>{item.amountContext}</span>}
                    </dd>
                  </div>
                ))}
              </dl>
            </article>
          ))
        }
      </div>

      <footer class="price-list-footer">
        <p>
          <strong>Greit å vite:</strong> Legen skal gi deg kvittering for
          beløpet du har betalt. Lokale priser for attester og tjenester som
          ikke står på takstplakaten må bekreftes av legekontoret.
        </p>
        <div class="price-list-footer__source">
          <p>
            Kilde: <a href={priceList.sourceUrl}>{priceList.sourceLabel}</a>.
            Kontrollert {priceList.checkedOn}.
          </p>
          <a
            class="price-list-footer__logo"
            href={priceList.sourceUrl}
            target="_blank"
            rel="noreferrer"
            aria-label="Åpne offisiell takstplakat fra Den norske legeforening"
          >
            <img
              src="/images/resources/legeforeningen-logo.png"
              alt="Den norske legeforening"
              width="518"
              height="318"
              loading="lazy"
            />
          </a>
        </div>
      </footer>
    </div>
  </section>
</BaseLayout>
