---
import BaseLayout from '../layouts/BaseLayout.astro';
import FormIcon from '../components/FormIcon.astro';
import {
  eConsultationForms,
  patientFormCategories,
} from '../data/patientResources';
---

<BaseLayout
  title="Skjema | Vågsbygd legesenter"
  description="Kartleggingsskjema for psykisk helse, fysisk helse, livsstil og forberedelse til e-konsultasjon."
>
  <section class="form-directory" aria-labelledby="form-directory-heading">
    <div class="shell">
      <header class="form-directory__header">
        <p class="eyebrow">Kartlegging</p>
        <h1 id="form-directory-heading">Medisinske skåringsskjemaer</h1>
      </header>

      <div class="form-category-grid">
        {
          patientFormCategories.map((category) => (
            <section
              class:list={[
                'form-category',
                `form-category--${category.tone}`,
              ]}
              aria-labelledby={`form-category-${category.tone}`}
            >
              <header>
                <h3 id={`form-category-${category.tone}`}>{category.title}</h3>
                <p>{category.description}</p>
              </header>
              <ul>
                {category.forms.map((form) => (
                  <li>
                    <a href={form.href} target="_blank" rel="noreferrer">
                      {
                        form.icon && (
                          <span class="form-card__icon">
                            <FormIcon name={form.icon} />
                          </span>
                        )
                      }
                      <span class="form-card__copy">
                        <strong>{form.title}</strong>
                        <small>{form.description}</small>
                      </span>
                      <span class="form-card__arrow" aria-hidden="true">↗</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </div>
  </section>

  <section class="form-econsult" aria-labelledby="form-econsult-heading">
    <div class="shell form-econsult__layout">
      <header>
        <h2 id="form-econsult-heading">E-konsultasjon spørreskjemaer</h2>
        <p>
          Disse skjemaene kan gi legen en ryddig oversikt før du starter en
          e-konsultasjon. Legg gjerne til andre opplysninger som er viktige for
          deg.
        </p>
        <a class="text-link" href="/praktisk-informasjon/#e-konsultasjon">
          <span class="text-link__label">Les om e-konsultasjon</span>
          <span aria-hidden="true">→</span>
        </a>
      </header>

      <ul class="form-link-list">
        {
          eConsultationForms.map((form) => (
            <li>
              <a href={form.href} target="_blank" rel="noreferrer">
                <span>
                  <strong>{form.title}</strong>
                  <small>{form.description}</small>
                </span>
                <span aria-hidden="true">↗</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
