---
import { clinic } from '../data/clinic';
---

<footer class="site-footer">
  <div class="shell site-footer__grid">
    <div>
      <h2 class="site-footer__heading">
        <span class="site-footer__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"></path>
            <circle cx="12" cy="10" r="2.5"></circle>
          </svg>
        </span>
        Adresse
      </h2>
      <address>
        <a href={clinic.directionsUrl.value}>
          {clinic.address.value}<br />{clinic.postalAddress.value}
        </a>
      </address>
    </div>

    <div class="site-footer__phone">
      <h2 class="site-footer__heading">
        <span class="site-footer__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M7.1 3.5 4.4 6.2c-1.1 1.1.2 4.6 3.8 8.2s7.1 4.9 8.2 3.8l2.7-2.7-4-3-2 2c-1.3-.6-2.6-1.5-3.7-2.6a13 13 0 0 1-2.6-3.7l2-2Z"></path>
          </svg>
        </span>
        Telefon
      </h2>
      <a href={`tel:${clinic.phone.value}`}>{clinic.phoneDisplay.value}</a>
      <p>{clinic.phoneHours.value}</p>
    </div>

    <div class="site-footer__safety">
      <h2 class="site-footer__heading">
        <span class="site-footer__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M12 7.5v9M7.5 12h9"></path>
          </svg>
        </span>
        Når det haster
      </h2>
      <p>Ved fare for liv: <a href="tel:113">ring 113</a>.</p>
      <p>Legevakt: <a href="tel:116117">ring 116 117</a>.</p>
    </div>
  </div>
  <div class="shell site-footer__bottom">
    <p>© {new Date().getFullYear()} Vågsbygd legesenter</p>
  </div>
</footer>
