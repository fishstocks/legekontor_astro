---
import type { ServiceHighlight } from '../data/clinic';

interface Props {
  services: ServiceHighlight[];
}

const { services } = Astro.props;
---

<ul class="home-service-list">
  {
    services.map((service) => (
      <li class="home-service-item">
        <span class="home-service-item__icon" aria-hidden="true">
          {service.icon === 'urgent' && (
            <svg viewBox="0 0 32 32">
              <path d="M16 27S5 20.4 5 12.2A6.2 6.2 0 0 1 16 8.3a6.2 6.2 0 0 1 11 3.9C27 20.4 16 27 16 27z" />
              <path d="M16 11v8M12 15h8" />
            </svg>
          )}
          {service.icon === 'followup' && (
            <svg viewBox="0 0 32 32">
              <path d="M8 5v8a6 6 0 0 0 12 0V5M6 5h4M18 5h4" />
              <path d="M20 15v4a6 6 0 0 0 12 0v-2" />
              <circle cx="29" cy="14" r="2" />
            </svg>
          )}
          {service.icon === 'prevention' && (
            <svg viewBox="0 0 32 32">
              <path d="M16 4 26 8v7c0 6.2-4.1 10.4-10 13-5.9-2.6-10-6.8-10-13V8z" />
              <path d="m11 16 3 3 7-8" />
            </svg>
          )}
          {service.icon === 'cervical' && (
            <svg viewBox="0 0 32 32">
              <circle cx="16" cy="16" r="10" />
              <path d="M16 10v12M10 16h12" />
              <path d="M8 7 5 4M24 7l3-3M8 25l-3 3M24 25l3 3" />
            </svg>
          )}
          {service.icon === 'surgery' && (
            <svg viewBox="0 0 32 32">
              <path d="m7 25 14-14 4 4-14 14H7z" />
              <path d="m19 9 3-3 4 4-3 3M7 25l-2 2" />
            </svg>
          )}
          {service.icon === 'diagnostics' && (
            <svg viewBox="0 0 32 32">
              <rect x="4" y="6" width="24" height="20" rx="2" />
              <path d="M7 17h5l2-5 4 10 2-5h5" />
            </svg>
          )}
          {service.icon === 'tests' && (
            <svg viewBox="0 0 32 32">
              <path d="M12 4h8M14 4v8L7 25a2 2 0 0 0 2 3h14a2 2 0 0 0 2-3l-7-13V4" />
              <path d="M10 21h12" />
            </svg>
          )}
          {service.icon === 'documents' && (
            <svg viewBox="0 0 32 32">
              <path d="M8 3h12l5 5v21H8zM20 3v6h6" />
              <path d="M12 16h9M12 21h7" />
            </svg>
          )}
          {service.icon === 'vaccines' && (
            <svg viewBox="0 0 32 32">
              <path d="m8 24 13-13M18 8l6 6M15 11l6 6M7 21l4 4-4 4-4-4z" />
              <path d="m22 7 3-3M24 5l3 3" />
            </svg>
          )}
        </span>
        <div>
          <h3>{service.title}</h3>
          <p>{service.description}</p>
        </div>
      </li>
    ))
  }
</ul>
