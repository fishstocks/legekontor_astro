---
import Logo from './Logo.astro';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const items = [
  { href: '/', label: 'Forside' },
  { href: '/ansatte/', label: 'Ansatte' },
  { href: '/tjenester-og-priser/', label: 'Priser' },
  { href: '/skjema/', label: 'Skjema' },
  { href: '/praktisk-informasjon/', label: 'Praktisk informasjon' },
  { href: '/#kontakt', label: 'Kontakt' },
];

const isCurrent = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="site-header" data-site-header>
  <div class="shell site-header__inner">
    <a class="site-header__logo" href="/">
      <Logo />
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="hovedmeny"
      data-menu-toggle
    >
      <span class="menu-toggle__label">Meny</span>
      <span class="menu-toggle__icon" aria-hidden="true">
        <span></span><span></span>
      </span>
    </button>

    <nav class="site-nav" id="hovedmeny" aria-label="Hovedmeny" data-menu>
      <ul>
        {
          items.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a
        class="button button--small site-nav__cta"
        href="https://minhelse.helsenorge.no/"
        target="_blank"
        rel="noreferrer"
        aria-label="Bestill time på Helsenorge (åpnes i ny fane)"
      >
        Bestill time
      </a>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector('[data-site-header]');
  const toggle = header?.querySelector('[data-menu-toggle]');
  const menu = header?.querySelector('[data-menu]');

  if (header instanceof HTMLElement) {
    const mobileHeaderQuery = window.matchMedia('(max-width: 1024px)');

    const updateScrollState = () => {
      header.toggleAttribute('data-scrolled', window.scrollY > 12);

      const isCollapsed = header.hasAttribute('data-mobile-collapsed');
      const collapseAfter = isCollapsed ? 16 : 72;
      header.toggleAttribute(
        'data-mobile-collapsed',
        mobileHeaderQuery.matches && window.scrollY > collapseAfter,
      );
    };

    updateScrollState();
    window.addEventListener('scroll', updateScrollState, { passive: true });
    mobileHeaderQuery.addEventListener('change', (event) => {
      updateScrollState();

      if (!event.matches) {
        if (toggle instanceof HTMLButtonElement) {
          toggle.setAttribute('aria-expanded', 'false');
        }
        if (menu instanceof HTMLElement) {
          menu.removeAttribute('data-open');
        }
        document.body.classList.remove('menu-is-open');
      }
    });
  }

  if (toggle instanceof HTMLButtonElement && menu instanceof HTMLElement) {
    const reducedMotionQuery = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    );
    let closeTimer: number | undefined;

    const finishClosing = () => {
      menu.removeAttribute('data-closing');
      closeTimer = undefined;
    };

    const closeMenu = () => {
      const isVisible =
        menu.hasAttribute('data-open') || menu.hasAttribute('data-closing');

      toggle.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('menu-is-open');

      if (!isVisible) return;

      menu.removeAttribute('data-open');

      if (closeTimer !== undefined) {
        window.clearTimeout(closeTimer);
      }

      if (reducedMotionQuery.matches) {
        finishClosing();
        return;
      }

      menu.setAttribute('data-closing', '');
      closeTimer = window.setTimeout(finishClosing, 180);
    };

    const openMenu = () => {
      if (closeTimer !== undefined) {
        window.clearTimeout(closeTimer);
        closeTimer = undefined;
      }

      menu.removeAttribute('data-closing');
      toggle.setAttribute('aria-expanded', 'true');
      menu.setAttribute('data-open', '');
      document.body.classList.add('menu-is-open');
    };

    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });

    window.addEventListener(
      'scroll',
      () => {
        if (toggle.getAttribute('aria-expanded') === 'true') {
          closeMenu();
        }
      },
      { passive: true },
    );

    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        closeMenu();
        toggle.focus();
      }
    });
  }
</script>
