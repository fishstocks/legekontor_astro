---
import type { PatientFormLink } from '../data/patientResources';

interface Props {
  name: NonNullable<PatientFormLink['icon']>;
}

const { name } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  aria-hidden="true"
  fill="none"
  stroke="currentColor"
  stroke-linecap="round"
  stroke-linejoin="round"
  stroke-width="1.8"
>
  {
    name === 'mood' && (
      <>
        <path d="M20.8 8.6c0 5.6-8.8 11-8.8 11s-8.8-5.4-8.8-11A4.7 4.7 0 0 1 12 6.3a4.7 4.7 0 0 1 8.8 2.3Z" />
        <path d="M7.7 12h2.1l1.2-2.5 2 5 1.2-2.5h2.1" />
      </>
    )
  }
  {
    name === 'anxiety' && (
      <>
        <path d="M4 8.5c1.5-1.4 3-1.4 4.5 0s3 1.4 4.5 0 3-1.4 4.5 0" />
        <path d="M4 12c1.5-1.4 3-1.4 4.5 0s3 1.4 4.5 0 3-1.4 4.5 0" />
        <path d="M4 15.5c1.5-1.4 3-1.4 4.5 0s3 1.4 4.5 0 3-1.4 4.5 0" />
      </>
    )
  }
  {
    name === 'focus' && (
      <>
        <circle cx="12" cy="12" r="7.5" />
        <circle cx="12" cy="12" r="2.3" />
        <path d="M12 2v3M12 19v3M2 12h3M19 12h3" />
      </>
    )
  }
  {
    name === 'history' && (
      <>
        <path d="M4.5 7.5H8v-3" />
        <path d="M5 7a8 8 0 1 1-1 7" />
        <path d="M12 8v4l2.8 1.8" />
      </>
    )
  }
  {
    name === 'profile' && (
      <>
        <circle cx="12" cy="8" r="3" />
        <path d="M5.5 20c.8-4 3-6 6.5-6s5.7 2 6.5 6" />
      </>
    )
  }
  {
    name === 'droplet' && (
      <path d="M12 2.8s6 6.4 6 11a6 6 0 0 1-12 0c0-4.6 6-11 6-11Z" />
    )
  }
  {
    name === 'back' && (
      <>
        <path d="M10 3.5c-1.5 2.2-1.5 4.1 0 5.7s1.5 3.6 0 5.4-1.5 3.8 0 5.9" />
        <path d="M14 3.5c1.5 2.2 1.5 4.1 0 5.7s-1.5 3.6 0 5.4 1.5 3.8 0 5.9" />
        <path d="M10 9.2h4M10 14.6h4" />
      </>
    )
  }
  {
    name === 'function' && (
      <>
        <rect x="5.5" y="4.5" width="13" height="16" rx="1.5" />
        <path d="M9 4.5v-1h6v1M9 11l2 2 4-4M9 17h6" />
      </>
    )
  }
  {
    name === 'sleep' && (
      <path d="M19.5 15.2A8 8 0 0 1 8.8 4.5 8 8 0 1 0 19.5 15.2Z" />
    )
  }
  {
    name === 'wellbeing' && (
      <>
        <path d="M19.5 4.5C12 4.7 7.3 8.2 6.5 15.7c7.5.8 11-3.9 13-11.2Z" />
        <path d="M4.5 19.5c2.7-4.2 6-7.2 10.2-9.2" />
      </>
    )
  }
</svg>
