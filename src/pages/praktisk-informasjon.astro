---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceGuides from '../components/ServiceGuides.astro';
import { bloodTestResource, publicHealthResources } from '../data/clinic';
import {
  resultTimes,
  vaccineLinks,
  vaccineSteps,
  vaccineTopics,
} from '../data/patientResources';

const topics = [
  ['helsenorge', 'Helsenorge', 'phone'],
  ['frikort', 'Frikort', 'coins'],
  ['provesvar', 'Prøvesvar', 'sample'],
  ['henvisninger', 'Henvisninger', 'referral'],
  ['sykefravaer', 'Sykefravær', 'work'],
  ['vaksiner', 'Vaksiner', 'shield'],
  ['nyttige-lenker', 'Nyttige lenker', 'links'],
] as const;

const practiceNotes = [
  {
    label: 'Varighet og innhold i konsultasjoner',
    details: [
      'Legetimer varer vanligvis 15–20 minutter og er som hovedregel beregnet for én problemstilling. Dersom du har flere forhold du ønsker å ta opp, kan det være nødvendig med en ny time.',
      'Tiden inkluderer også nødvendig journalføring, resepter, henvisninger og annet administrativt arbeid for legen. Behov for dobbeltime vurderes av fastlegen. Det er ikke alltid kapasitet til dobbeltime, selv om det kan være ønskelig.',
    ],
  },
  {
    label: 'Endring i sykmeldingspraksis fra 1. juli 2026',
    details: [
      'I tråd med nasjonale føringer skal gradert sykmelding som hovedregel benyttes der dette er medisinsk forsvarlig. Full sykmelding gis kun når medisinske forhold tilsier at arbeid ikke er mulig.',
      'Sykmeldingsgraden fastsettes av legen i henhold til medisinsk vurdering og gjeldende regelverk.',
    ],
  },
] as const;

const frikortUrl =
  'https://www.helsenorge.no/betaling-for-helsetjenester/frikort-for-helsetjenester/';

---

<BaseLayout
  title="Praktisk informasjon | Vågsbygd legesenter"
  description="Praktisk pasientinformasjon om Helsenorge, prøvesvar, henvisninger, sykmelding, vaksiner og nyttige offentlige tjenester."
>
  <svg class="practical-icon-sprite" aria-hidden="true">
    <symbol id="practical-overview" viewBox="0 0 24 24">
      <path d="M5 6.5h14M5 12h14M5 17.5h8"></path>
      <circle cx="18" cy="17.5" r="1.5"></circle>
    </symbol>
    <symbol id="practical-phone" viewBox="0 0 24 24">
      <rect x="7" y="3" width="10" height="18" rx="2"></rect>
      <path d="M10 6h4M10 17h4"></path>
    </symbol>
    <symbol id="practical-sample" viewBox="0 0 24 24">
      <path d="M9 3h6M10 3v6l-4.5 8.2A2.5 2.5 0 0 0 7.7 21h8.6a2.5 2.5 0 0 0 2.2-3.8L14 9V3"></path>
      <path d="M8 15h8"></path>
    </symbol>
    <symbol id="practical-coins" viewBox="0 0 24 24">
      <ellipse cx="8" cy="6" rx="4.5" ry="2"></ellipse>
      <path d="M3.5 6v4c0 1.1 2 2 4.5 2 1.1 0 2.1-.2 3-.5M3.5 10v4c0 1.1 2 2 4.5 2 .8 0 1.6-.1 2.3-.3"></path>
      <ellipse cx="16" cy="12" rx="4.5" ry="2"></ellipse>
      <path d="M11.5 12v4c0 1.1 2 2 4.5 2s4.5-.9 4.5-2v-4M11.5 16v2.5c0 1.1 2 2 4.5 2s4.5-.9 4.5-2V16"></path>
    </symbol>
    <symbol id="practical-referral" viewBox="0 0 24 24">
      <path d="M7 3h7l4 4v14H7z"></path>
      <path d="M14 3v5h5M10 12h5M10 16h5"></path>
    </symbol>
    <symbol id="practical-work" viewBox="0 0 24 24">
      <rect x="3" y="7" width="18" height="13" rx="2"></rect>
      <path d="M8 7V4h8v3M3 12h18M10 12v2h4v-2"></path>
    </symbol>
    <symbol id="practical-shield" viewBox="0 0 24 24">
      <path d="M12 3 20 6v5c0 5.1-3.1 8.3-8 10-4.9-1.7-8-4.9-8-10V6z"></path>
      <path d="M9 12h6M12 9v6"></path>
    </symbol>
    <symbol id="practical-links" viewBox="0 0 24 24">
      <path d="m9.5 14.5 5-5"></path>
      <path d="M7.5 17.5H6a4 4 0 0 1 0-8h3M16.5 6.5H18a4 4 0 0 1 0 8h-3"></path>
    </symbol>
    <symbol id="practical-clock" viewBox="0 0 24 24">
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M12 7v5l3 2"></path>
    </symbol>
    <symbol id="practical-language" viewBox="0 0 24 24">
      <path d="M4 5h10M9 3v2c0 5-2.5 8-5 10M6 10c1.2 1.8 3 3.2 5 4"></path>
      <path d="m14 19 3.5-9 3.5 9M15.5 16h4"></path>
    </symbol>
    <symbol id="practical-document" viewBox="0 0 24 24">
      <path d="M6 3h9l3 3v15H6z"></path>
      <path d="M15 3v4h4M9 11h6M9 15h6"></path>
    </symbol>
    <symbol id="practical-results" viewBox="0 0 24 24">
      <path d="M5 4h14v16H5z"></path>
      <path d="M8 15h2l1.5-5 2 7 1.5-4h2"></path>
    </symbol>
    <symbol id="practical-calendar" viewBox="0 0 24 24">
      <rect x="3" y="5" width="18" height="16" rx="2"></rect>
      <path d="M8 3v4M16 3v4M3 10h18M8 15l2 2 5-5"></path>
    </symbol>
    <symbol id="practical-prescription" viewBox="0 0 24 24">
      <path d="M7 3h10v18H7zM10 7h4M10 11h4M10 15h2"></path>
    </symbol>
    <symbol id="practical-message" viewBox="0 0 24 24">
      <path d="M4 4h16v12H9l-5 4z"></path>
      <path d="M8 8h8M8 12h5"></path>
    </symbol>
    <symbol id="practical-conversation" viewBox="0 0 24 24">
      <path d="M3 5h13v10H8l-5 4z"></path>
      <path d="M16 8h5v9l-3-2h-3M7 9h5"></path>
    </symbol>
  </svg>

  <aside class="practical-float-nav">
    <details>
      <summary aria-label="Åpne sidenavigasjon">
        <svg aria-hidden="true"><use href="#practical-overview" /></svg>
      </summary>
      <div class="practical-float-nav__body">
        <div class="practical-float-nav__header">
          <svg aria-hidden="true"><use href="#practical-overview" /></svg>
          <span>På siden</span>
          <button
            class="practical-float-nav__toggle"
            type="button"
            aria-label="Lukk sidenavigasjon"
            data-practical-nav-close
          >
            <span aria-hidden="true">+</span>
          </button>
        </div>
        <nav aria-label="Naviger på siden">
          {
            topics.map(([id, label, icon]) => (
              <a href={`#${id}`}>
                <svg aria-hidden="true"><use href={`#practical-${icon}`} /></svg>
                <span>{label}</span>
              </a>
            ))
          }
        </nav>
      </div>
    </details>
  </aside>

  <h1 class="visually-hidden">Praktisk informasjon</h1>

  <aside class="practical-notes" aria-labelledby="practical-notes-heading">
    <div class="shell practical-notes__layout">
      <header>
        <p class="eyebrow">Greit å vite</p>
        <h2 id="practical-notes-heading">Om konsultasjon og sykmelding</h2>
      </header>

      <div class="practical-notes__grid">
        {
          practiceNotes.map((note) => (
            <article>
              <h3>{note.label}</h3>
              {note.details.map((detail) => <p>{detail}</p>)}
            </article>
          ))
        }
      </div>
    </div>
  </aside>

  <section
    id="helsenorge"
    class="practical-digital"
    aria-labelledby="helsenorge-heading"
  >
    <div class="shell practical-digital__grid">
      <div class="practical-digital__side">
        <header class="practical-digital__intro">
          <figure class="practical-digital__phone">
            <img
              src="/images/helsenorge-app.png"
              alt="Helsenorge-appen vist på en mobiltelefon"
              width="296"
              height="330"
              loading="lazy"
            />
          </figure>
          <p class="eyebrow">Digital kontakt</p>
          <h2 id="helsenorge-heading">Bruk Helsenorge</h2>
          <p>
            Helsenorge er den sikre inngangen til legekontoret når henvendelsen
            ikke haster.
          </p>
          <div class="practical-digital__actions">
            <a
              class="button"
              href="https://minhelse.helsenorge.no/"
              target="_blank"
              rel="noreferrer"
            >
              Åpne Helsenorge <span aria-hidden="true">→</span>
            </a>
          </div>
        </header>
      </div>

      <div class="practical-digital__guides">
        <ServiceGuides />
      </div>
    </div>
  </section>

  <section
    id="frikort"
    class="practical-frikort"
    aria-labelledby="frikort-heading"
  >
    <div class="shell practical-frikort__grid">
      <header class="practical-frikort__intro">
        <p class="eyebrow">Betaling for helsetjenester</p>
        <h2 id="frikort-heading">Frikort</h2>
        <p>
          Frikortordningen begrenser hvor mye du betaler i godkjente
          egenandeler i løpet av et kalenderår.
        </p>

        <div class="practical-frikort__threshold">
          <strong>3 278 kr</strong>
          <span>Egenandelstaket i 2026</span>
        </div>
        <svg class="practical-frikort__illustration" aria-hidden="true">
          <use href="#practical-coins" />
        </svg>
      </header>

      <div class="practical-frikort__details">
        <h3>Dette bør du vite</h3>
        <ul>
          <li>
            Når du har betalt over egenandelstaket, får du normalt frikort innen
            tre uker. Deretter slipper du å betale godkjente egenandeler resten
            av kalenderåret.
          </li>
          <li>
            Ordningen er automatisk. Frikortet og registrerte egenandeler
            finner du når du logger inn på Helsenorge. Har du betalt for mye,
            blir beløpet du har krav på automatisk tilbakebetalt.
          </li>
          <li>
            Ikke all pasientbetaling teller med. Blant annet helseattester,
            materiell, kopiering eller oversending av journal og
            sesonginfluensavaksine faller utenfor.
          </li>
        </ul>
        <p>Ta vare på kvitteringene slik at du kan kontrollere registreringene.</p>
        <a href={frikortUrl} target="_blank" rel="noreferrer">
          <span>Les mer om frikort på Helsenorge</span>
          <span class="link-arrow-ring" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="practical-after" aria-label="Etter undersøkelsen">
    <div class="shell practical-after__grid">
      <article
        id="provesvar"
        class="practical-panel practical-panel--sea"
        aria-labelledby="provesvar-heading"
      >
        <header>
          <svg aria-hidden="true"><use href="#practical-results" /></svg>
          <p class="eyebrow">Etter undersøkelsen</p>
          <h2 id="provesvar-heading">Prøvesvar</h2>
          <p>
            Svartiden varierer etter prøvetype og laboratorium. Legen tar
            kontakt slik dere har avtalt.
          </p>
        </header>

        <dl class="practical-result-times">
          {
            resultTimes.map(([label, time]) => (
              <div>
                <dt>{label}</dt>
                <dd>{time}</dd>
              </div>
            ))
          }
        </dl>

        <p class="practical-review-note">
          Oppgitte svartider er veiledende og må bekreftes av legekontoret før
          publisering.
        </p>
      </article>

      <article
        id="henvisninger"
        class="practical-panel practical-panel--sand"
        aria-labelledby="henvisninger-heading"
      >
        <header>
          <svg aria-hidden="true"><use href="#practical-referral" /></svg>
          <p class="eyebrow">Videre behandling</p>
          <h2 id="henvisninger-heading">Henvisninger og celleprøve</h2>
        </header>

        <div class="practical-referrals">
          <section>
            <h3>Henvisning til spesialist</h3>
            <p>
              Bestill time hos fastlegen dersom problemstillingen ikke allerede
              er vurdert. En oppdatert henvisning gjør det lettere å vurdere
              hastegrad og riktig tilbud.
            </p>
            <p>
              Manglende opplysninger kan føre til at behandlingsstedet må be om
              mer informasjon.
            </p>
          </section>
          <section>
            <h3>Celleprøve og spiral</h3>
            <p>
              Celleprøve kan tas hos fastlegen. Innsetting eller fjerning av
              spiral avtales med legekontoret.
            </p>
            <p>
              Henvisning til gynekolog krever vanligvis en medisinsk
              problemstilling som bør vurderes av spesialist.
            </p>
          </section>
        </div>
      </article>
    </div>
  </section>

  <section
    id="sykefravaer"
    class="practical-work"
    aria-labelledby="sykefravaer-heading"
  >
    <div class="shell practical-work__grid">
      <header>
        <svg aria-hidden="true"><use href="#practical-work" /></svg>
        <p class="eyebrow">Arbeid og familie</p>
        <h2 id="sykefravaer-heading">Sykmelding og egenmelding</h2>
        <p>
          Reglene avhenger av situasjonen din. Åpne temaet som passer for å se
          hva du bør gjøre videre.
        </p>
      </header>

      <div class="practical-disclosures">
        <details open>
          <summary>
            <strong>Egenmelding</strong>
            <span aria-hidden="true">+</span>
          </summary>
          <div>
            <p>
              Du må normalt ha jobbet hos arbeidsgiveren i minst to måneder.
              Egenmelding kan brukes i arbeidsgiverperioden og kan ikke
              kombineres med gradert sykmelding.
            </p>
            <p>
              Ordningen varierer mellom arbeidsplasser. Sjekk rutinene hos
              arbeidsgiveren din.
            </p>
            <a href="https://www.nav.no/egenmelding">Les mer hos NAV →</a>
          </div>
        </details>

        <details>
          <summary>
            <strong>Sykmelding</strong>
            <span aria-hidden="true">+</span>
          </summary>
          <div>
            <p>
              Legen må ha tilstrekkelig grunnlag for å vurdere hvordan sykdom
              eller skade påvirker arbeidsevnen. Du må derfor ha en
              konsultasjon.
            </p>
            <p>
              Gradert sykmelding eller tilrettelegging kan være aktuelt når du
              fortsatt har noe arbeidsevne.
            </p>
            <a href="https://www.nav.no/sykepenger">Les mer hos NAV →</a>
          </div>
        </details>

        <details>
          <summary>
            <strong>Barns sykdom</strong>
            <span aria-hidden="true">+</span>
          </summary>
          <div>
            <p>
              Når du må være hjemme med sykt barn, bruker du vanligvis
              omsorgsdager. Ved alvorlig sykdom og behov for kontinuerlig pleie
              kan pleiepenger være aktuelt.
            </p>
            <p class="practical-inline-links">
              <a href="https://www.nav.no/omsorgspenger">Omsorgsdager →</a>
              <a href="https://www.nav.no/pleiepenger-barn">Pleiepenger →</a>
            </p>
          </div>
        </details>

        <details>
          <summary>
            <strong>Dødsfall i familien</strong>
            <span aria-hidden="true">+</span>
          </summary>
          <div>
            <p>
              Sorg alene gir normalt ikke grunnlag for sykmelding. Dersom
              belastningen fører til egen sykdom og nedsatt arbeidsevne, kan
              legen vurdere behovet.
            </p>
          </div>
        </details>
      </div>
    </div>
  </section>

  <section
    id="vaksiner"
    class="practical-vaccines"
    aria-labelledby="vaksiner-heading"
  >
    <div class="shell">
      <div class="practical-vaccines__intro">
        <header>
          <svg aria-hidden="true"><use href="#practical-shield" /></svg>
          <p class="eyebrow">Forebygging</p>
          <h2 id="vaksiner-heading">Vaksiner</h2>
          <p>
            Sjekk anbefalingene i god tid, særlig dersom du planlegger en reise.
          </p>
        </header>

        <ol class="practical-vaccine-process">
          {
            vaccineSteps.map((step, index) => (
              <li>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <div>
                  <h3>{step.title}</h3>
                  <p>{step.description}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="practical-vaccine-details">
        <div class="practical-vaccine-topics">
          {
            vaccineTopics.map((topic) => (
              <article class="practical-vaccine-topic">
                <header>
                  <h3>{topic.title}</h3>
                  <p class="practical-vaccine-topic__subtitle">{topic.subtitle}</p>
                </header>
                <p>{topic.description}</p>
              </article>
            ))
          }
        </div>

        <nav class="practical-source-links" aria-label="Offisiell vaksineinformasjon">
          {vaccineLinks.map((link) => (
            <a href={link.href}>
              <span>
                <strong>{link.title}</strong>
                <small>{link.source}</small>
              </span>
              <span class="link-arrow-ring" aria-hidden="true">→</span>
            </a>
          ))}
        </nav>
      </div>
    </div>
  </section>

  <section
    id="nyttige-lenker"
    class="practical-resources"
    aria-labelledby="nyttige-lenker-heading"
  >
    <div class="shell">
      <header class="practical-section-heading practical-section-heading--split">
        <div>
          <p class="eyebrow">Offentlige tjenester</p>
          <h2 id="nyttige-lenker-heading">Nyttige lenker</h2>
        </div>
        <p>
          Kvalitetssikrede tjenester for prøvesvar, rettigheter, refusjon og
          offentlig helseinformasjon.
        </p>
      </header>

      <a class="practical-feature-link" href={bloodTestResource.href}>
        <span class="practical-feature-link__mark">
          <img
            src={bloodTestResource.logo}
            alt={bloodTestResource.logoAlt}
            width="48"
            height="48"
          />
        </span>
        <span>
          <strong>{bloodTestResource.name}</strong>
          <small>{bloodTestResource.description}</small>
        </span>
        <span class="link-arrow-ring" aria-hidden="true">→</span>
      </a>

      <div class="practical-official-links">
        {
          publicHealthResources.map((resource) => (
            <a href={resource.href}>
              <img
                src={resource.logo}
                alt=""
                width="40"
                height="40"
                loading="lazy"
              />
              <span>
                <strong>{resource.name}</strong>
                <small>{resource.description}</small>
              </span>
              <span class="link-arrow-ring" aria-hidden="true">→</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <script>
    const floatingMenu = document.querySelector('.practical-float-nav details');
    const floatingMenuSummary = floatingMenu?.querySelector('summary');
    const floatingMenuClose = floatingMenu?.querySelector(
      '[data-practical-nav-close]',
    );
    const floatingMenuLinks = Array.from(
      floatingMenu?.querySelectorAll<HTMLAnchorElement>('nav a[href^="#"]') ?? [],
    );
    const floatingMenuSections: Array<{
      id: string;
      link: HTMLAnchorElement;
      section: HTMLElement;
    }> = [];

    floatingMenuLinks.forEach((link) => {
      const id = link.hash.slice(1);
      const section = document.getElementById(id);

      if (section) {
        floatingMenuSections.push({ id, link, section });
      }
    });

    const setActiveSection = (activeId?: string) => {
      floatingMenuSections.forEach(({ id, link }) => {
        const isActive = id === activeId;

        link.classList.toggle('is-active', isActive);

        if (isActive) {
          link.setAttribute('aria-current', 'location');
        } else {
          link.removeAttribute('aria-current');
        }
      });
    };

    let activeSectionFrame: number | undefined;

    const updateActiveSection = () => {
      activeSectionFrame = undefined;
      const readingLine = window.scrollY + window.innerHeight * 0.34;
      let activeId: string | undefined;

      floatingMenuSections.forEach(({ id, section }) => {
        const sectionTop = section.getBoundingClientRect().top + window.scrollY;

        if (sectionTop <= readingLine) {
          activeId = id;
        }
      });

      setActiveSection(activeId);
    };

    const scheduleActiveSectionUpdate = () => {
      if (activeSectionFrame !== undefined) return;

      activeSectionFrame = window.requestAnimationFrame(updateActiveSection);
    };

    floatingMenuClose?.addEventListener('click', () => {
      floatingMenu?.removeAttribute('open');
      floatingMenuSummary?.focus();
    });

    floatingMenuLinks.forEach((link) => {
      link.addEventListener('click', () => {
        setActiveSection(link.hash.slice(1));
        floatingMenu?.removeAttribute('open');
      });
    });

    const mainMenuToggle = document.querySelector('[data-menu-toggle]');
    mainMenuToggle?.addEventListener('click', () => {
      if (mainMenuToggle.getAttribute('aria-expanded') === 'true') {
        floatingMenu?.removeAttribute('open');
      }
    });

    window.addEventListener('scroll', scheduleActiveSectionUpdate, {
      passive: true,
    });
    window.addEventListener('resize', scheduleActiveSectionUpdate);
    window.addEventListener('hashchange', scheduleActiveSectionUpdate);
    updateActiveSection();
  </script>
</BaseLayout>
