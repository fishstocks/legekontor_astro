---
import BaseLayout from '../layouts/BaseLayout.astro';
import PatientActions from '../components/PatientActions.astro';
import NoticeBanner from '../components/NoticeBanner.astro';
import StaffCard from '../components/StaffCard.astro';
import ServiceHighlights from '../components/ServiceHighlights.astro';
import EmergencyInfo from '../components/EmergencyInfo.astro';
import ResourceCard from '../components/ResourceCard.astro';
import FhiNewsCard from '../components/FhiNewsCard.astro';
import OpeningHours from '../components/OpeningHours.astro';
import {
  beforeVisitInfo,
  bloodTestResource,
  clinic,
  clinicSwitchInfo,
  fhiNews,
  notices,
  publicHealthResources,
  serviceHighlights,
  staffPreview,
} from '../data/clinic';

const activeNotice = notices.find((notice) => notice.active);
---

<BaseLayout
  title="Vågsbygd legesenter | Fastlege i Kristiansand"
  description="Praktisk informasjon, timebestilling, resepter og kontakt med Vågsbygd legesenter i Andøyveien 23, Kristiansand."
>
  <section class="home-hero">
    <figure class="home-hero__backdrop">
      <picture>
        <source
          media="(max-width: 760px)"
          srcset="/images/vagsbygd-courtyard-mobile.webp"
        />
        <img
          src="/images/vagsbygd-courtyard-wide.webp"
          alt=""
          width="1800"
          height="1299"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
    </figure>
    <div class="shell home-hero__grid">
      <div class="home-hero__copy">
        <p class="eyebrow">Fastlege i Kristiansand</p>
        <h1>Trygg legehjelp, <strong>nær deg</strong> i Vågsbygd.</h1>
        <p class="home-hero__intro">
          Hos Vågsbygd legesenter finner du praktisk informasjon og en enkel
          vei til timebestilling, resepter og kontakt med legekontoret.
        </p>
        <div class="home-hero__meta">
          <a href="#kontakt">Andøyveien 23, Kristiansand</a>
          <span>Lokalt legekontor</span>
        </div>
      </div>
    </div>
  </section>

  <section class="patient-actions" aria-label="Pasienttjenester">
    <div class="shell">
      <div class="patient-actions__module">
        <PatientActions actions={clinic.patientActions} />
        <aside class="patient-actions__note" aria-label="Kontakt med legesenteret">
          <div class="patient-actions__note-main">
            <span class="patient-actions__note-logo" aria-hidden="true">
              <img
                src="/images/resources/helsenorge.svg"
                alt=""
                width="32"
                height="32"
              />
            </span>
            <div>
              <p class="eyebrow">Helsenorge på nett og i appen</p>
              <p>
                Bruk Helsenorge til de digitale tjenestene ovenfor og til
                administrative henvendelser. Du kan alltid ringe legekontoret.
              </p>
            </div>
          </div>
          <a
            class="patient-actions__note-link"
            href="/praktisk-informasjon/#helsenorge"
          >
            Les hvordan tjenestene fungerer <span aria-hidden="true">→</span>
          </a>
        </aside>
      </div>
      {
        activeNotice && (
          <div class="patient-actions__notice">
            <NoticeBanner notice={activeNotice} />
          </div>
        )
      }
    </div>
  </section>

  <section class="section patient-info-section" aria-labelledby="before-visit-heading">
    <div class="shell patient-info-layout">
      <div class="patient-info-intro">
        <p class="eyebrow">Før timen</p>
        <h2 id="before-visit-heading">Greit å vite</h2>
        <p>
          Kort informasjon om det pasienter oftest spør oss om. Flere svar
          finner du på informasjonssiden.
        </p>
        <a class="text-link" href="/praktisk-informasjon/">
          All pasientinformasjon <span aria-hidden="true">→</span>
        </a>
      </div>
      <dl class="patient-info-list">
        {
          beforeVisitInfo.map((item) => (
            <div class="patient-info-item">
              <dt>{item.title}</dt>
              <dd>{item.description}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section" aria-labelledby="about-heading">
    <div class="shell about-preview">
      <div class="about-preview__copy">
        <p class="eyebrow">Om legekontoret</p>
        <h2 id="about-heading">Vågsbygd Torv legesenter</h2>
        <p>
          Vågsbygd Torv legesenter er et veldrevet legekontor bestående av
          fastlegene Tom Andre Aas og Sondre Sverd Rekdal. Annbjørg Jansen har
          dessverre sluttet hos oss, men fremover vil en ny lege starte i hennes
          tidligere hjemmel. Anna Bui jobber også som vikar ved senteret. Vi har
          adresse i 1. etasje i <strong>Andøyveien 23</strong> og gleder oss til
          å ta imot dere der.
        </p>
        <ul class="plain-check-list">
          <li>Vanlige fastlegetjenester og medisinsk oppfølging</li>
          <li>Oppfølging av både kortvarige og langvarige helseplager</li>
          <li>Sikker digital kontakt gjennom Helsenorge</li>
        </ul>
        <a class="button" href="#kontakt">
          Se åpningstider og kontakt
        </a>
      </div>
      <figure class="clinic-photo clinic-photo--home">
        <img
          src="/images/legekontoret-720.webp"
          srcset="/images/legekontoret-720.webp 720w, /images/legekontoret.webp 1500w"
          sizes="(max-width: 860px) calc(100vw - 32px), 48vw"
          alt="Trebygning med grønne tak og uteområde ved Vågsbygd legesenter"
          width="1500"
          height="945"
          loading="lazy"
        />
        <figcaption>
          Legekontorets omgivelser. Bildeteksten må bekreftes før publisering.
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section section--mist staff-showcase" aria-labelledby="staff-heading">
    <div class="shell">
      <div class="staff-showcase__header">
        <div class="section-heading">
          <p class="eyebrow">Teamet</p>
          <h2 id="staff-heading">Menneskene på legekontoret</h2>
        </div>
        <a class="text-link staff-showcase__more" href="/ansatte/">
          Les mer om de ansatte <span aria-hidden="true">→</span>
        </a>
      </div>
      <div
        id="staff-carousel"
        class="staff-grid staff-grid--editorial staff-grid--carousel"
        role="region"
        tabindex="0"
        aria-label="Ansattkort som kan bla sidelengs"
      >
        {staffPreview.map((member) => <StaffCard member={member} editorial />)}
      </div>
      <div class="staff-carousel__buttons" aria-label="Naviger mellom ansatte">
        <button
          class="staff-carousel__button"
          type="button"
          aria-label="Vis forrige ansatte"
          aria-controls="staff-carousel"
          data-staff-previous
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="m15 5-7 7 7 7M8 12h10"></path>
          </svg>
        </button>
        <button
          class="staff-carousel__button staff-carousel__button--next"
          type="button"
          aria-label="Vis neste ansatte"
          aria-controls="staff-carousel"
          data-staff-next
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="m9 5 7 7-7 7M16 12H6"></path>
          </svg>
        </button>
      </div>
    </div>
  </section>

  <section class="section home-services" aria-labelledby="home-services-heading">
    <div class="shell">
      <header class="home-services__header">
        <p class="eyebrow">Våre tjenester</p>
        <h2 id="home-services-heading">Dette kan vi hjelpe deg med</h2>
      </header>
      <ServiceHighlights services={serviceHighlights} />
    </div>
  </section>

  <section class="section switch-clinic-section" aria-labelledby="switch-clinic-heading">
    <div class="shell switch-clinic-card">
      <div class="switch-clinic-card__copy">
        <p class="eyebrow">Ny pasient</p>
        <h2 id="switch-clinic-heading">{clinicSwitchInfo.title}</h2>
        <p class="switch-clinic-card__description">{clinicSwitchInfo.description}</p>
        <p class="switch-clinic-card__journal">
          <strong>Husk journaloverføring:</strong> {clinicSwitchInfo.journalNote}
        </p>
        <a class="button button--sand" href={clinicSwitchInfo.href}>
          Åpne Helsenorge
          <span aria-hidden="true">↗</span>
        </a>
      </div>
      <figure class="switch-clinic-card__image">
        <img
          src="/images/bytte-fastlege.webp"
          alt="Helsepersonell i grønne arbeidsklær med nettbrett og stetoskop"
          width="1400"
          height="933"
          loading="lazy"
        />
        <figcaption>
          Foto: <a href="https://www.pexels.com/photo/a-doctor-holding-a-digital-tablet-5206922/">Kaboompics / Pexels</a>
        </figcaption>
      </figure>
    </div>
  </section>

  <section
    id="kontakt"
    class="visit-contact-section"
    aria-label="Kontakt, åpningstider og øyeblikkelig hjelp"
  >
    <div class="shell visit-contact-shell">
      <div class="visit-contact-layout">
        <div class="contact-info-band">
          <div class="contact-info-band__grid">
            <OpeningHours clinic={clinic} showReviewState={false} />

            <div class="contact-info-band__emergency">
              <EmergencyInfo compact />
            </div>
          </div>

          <div class="contact-quick-links" aria-label="Kontaktinformasjon">
            <a class="contact-quick-link" href={`tel:${clinic.phone.value}`}>
              <span class="contact-quick-link__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path d="M22 16.9v3a2 2 0 0 1-2.2 2A19.8 19.8 0 0 1 3 5.2 2 2 0 0 1 5 3h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.4 2.1L9 11a16 16 0 0 0 4 4l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2Z"></path>
                </svg>
              </span>
              <span>
                <small>Telefon</small>
                <strong>{clinic.phoneDisplay.value}</strong>
              </span>
            </a>

            <a
              class="contact-quick-link"
              href="https://minhelse.helsenorge.no/"
              target="_blank"
              rel="noreferrer"
            >
              <span class="contact-quick-link__monogram" aria-hidden="true">Hn</span>
              <span>
                <small>Digital kontakt</small>
                <strong>Åpne Helsenorge ↗</strong>
              </span>
            </a>
          </div>
        </div>

        <div class="home-map-card">
          <iframe
            title="Google Maps-kart til Andøyveien 23"
            src="https://www.google.com/maps?q=And%C3%B8yveien%2023%2C%204623%20Kristiansand%20S&output=embed"
            width="1200"
            height="800"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>

          <div class="home-map-card__address">
            <span class="home-map-card__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"></path>
                <circle cx="12" cy="10" r="2.5"></circle>
              </svg>
            </span>
            <span>
              <strong>Vågsbygd legesenter</strong>
              <small>{clinic.address.value}, {clinic.postalAddress.value}</small>
            </span>
            <a href={clinic.directionsUrl.value} target="_blank" rel="noreferrer">
              Veibeskrivelse <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section resources-section" aria-labelledby="resources-heading">
    <div class="shell">
      <div class="resources-heading">
        <div>
          <p class="eyebrow">Nyttige ressurser</p>
          <h2 id="resources-heading">Trygge veier videre</h2>
        </div>
        <p>
          Her finner du offentlige helsetjenester og andre nyttige pasientportaler.
          Lenkene åpner tjenestens eget nettsted.
        </p>
      </div>

      <a class="blood-test-feature" href={bloodTestResource.href}>
        <span class="blood-test-feature__mark">
          <img
            src={bloodTestResource.logo}
            alt={bloodTestResource.logoAlt}
            width="64"
            height="64"
            loading="lazy"
            decoding="async"
          />
        </span>
        <span class="blood-test-feature__copy">
          <span class="eyebrow">Fürst pasientportal</span>
          <strong>{bloodTestResource.name}</strong>
          <span>{bloodTestResource.description}</span>
        </span>
        <span class="blood-test-feature__action">
          Logg inn og se blodprøvesvar
          <span aria-hidden="true">↗</span>
        </span>
      </a>

      <div class="resource-list-heading">
        <h3>Offentlige helsetjenester</h3>
      </div>
      <div class="resource-grid">
        {
          publicHealthResources.map((resource) => (
            <ResourceCard resource={resource} />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section fhi-section" aria-labelledby="fhi-heading">
    <div class="shell">
      <div class="fhi-section__header">
        <div>
          <p class="eyebrow">Nytt fra FHI</p>
          <h2 id="fhi-heading">Aktuelt om folkehelsen</h2>
        </div>
        <div class="fhi-section__source">
          <img
            src="/images/resources/fhi.svg"
            alt=""
            width="48"
            height="48"
            loading="lazy"
          />
          <span>
            <strong>Folkehelseinstituttet</strong>
            Oppdatert 26. juli 2026
          </span>
        </div>
      </div>
      <div class="fhi-news-grid">
        {fhiNews.map((item) => <FhiNewsCard item={item} />)}
      </div>
      <a class="fhi-section__all" href="https://www.fhi.no/nyheter/">
        Se alle nyheter hos FHI
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>

</BaseLayout>

<script>
  const staffCarousel = document.querySelector<HTMLElement>('#staff-carousel');
  const previousButton = document.querySelector<HTMLButtonElement>(
    '[data-staff-previous]',
  );
  const nextButton = document.querySelector<HTMLButtonElement>(
    '[data-staff-next]',
  );

  if (staffCarousel && previousButton && nextButton) {
    const originalStaffCards = Array.from(
      staffCarousel.querySelectorAll<HTMLElement>('.staff-card'),
    );
    const prefersReducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    );
    let updateFrame = 0;
    let cardStep = 0;
    let setWidth = 0;

    originalStaffCards.forEach((card, index) => {
      card.dataset.staffIndex = String(index);
      card.style.backgroundColor = window.getComputedStyle(card).backgroundColor;
    });

    const createClone = (card: HTMLElement, index: number) => {
      const clone = card.cloneNode(true) as HTMLElement;
      clone.dataset.staffIndex = String(index);
      clone.dataset.staffClone = 'true';
      clone.setAttribute('aria-hidden', 'true');
      return clone;
    };

    const leadingClones = document.createDocumentFragment();
    const trailingClones = document.createDocumentFragment();

    originalStaffCards.forEach((card, index) => {
      leadingClones.append(createClone(card, index));
      trailingClones.append(createClone(card, index));
    });

    staffCarousel.prepend(leadingClones);
    staffCarousel.append(trailingClones);

    const staffCards = Array.from(
      staffCarousel.querySelectorAll<HTMLElement>('.staff-card'),
    );

    const measureCarousel = () => {
      const firstCard = staffCards[0];
      const styles = window.getComputedStyle(staffCarousel);
      const gap = Number.parseFloat(styles.columnGap || styles.gap) || 0;
      cardStep = firstCard
        ? firstCard.offsetWidth + gap
        : staffCarousel.clientWidth;
      setWidth = cardStep * originalStaffCards.length;
    };

    const updateCenteredCard = () => {
      const carouselBounds = staffCarousel.getBoundingClientRect();
      const carouselCenter = carouselBounds.left + carouselBounds.width / 2;
      let closestCard: HTMLElement | undefined;
      let closestDistance = Number.POSITIVE_INFINITY;

      staffCards.forEach((card) => {
        const cardBounds = card.getBoundingClientRect();
        const cardCenter = cardBounds.left + cardBounds.width / 2;
        const distance = Math.abs(cardCenter - carouselCenter);

        if (distance < closestDistance) {
          closestCard = card;
          closestDistance = distance;
        }
      });

      staffCards.forEach((card) => {
        card.classList.toggle('is-centered', card === closestCard);
      });
    };

    const normalizeLoopPosition = () => {
      if (!setWidth) return;

      if (staffCarousel.scrollLeft < setWidth * 0.5) {
        staffCarousel.scrollLeft += setWidth;
      } else if (staffCarousel.scrollLeft > setWidth * 2.5) {
        staffCarousel.scrollLeft -= setWidth;
      }
    };

    const updateCarousel = () => {
      window.cancelAnimationFrame(updateFrame);
      updateFrame = window.requestAnimationFrame(() => {
        normalizeLoopPosition();
        updateCenteredCard();
      });
    };

    const scrollOneCard = (direction: -1 | 1) => {
      staffCarousel.scrollBy({
        left: direction * (cardStep || staffCarousel.clientWidth),
        behavior: prefersReducedMotion.matches ? 'auto' : 'smooth',
      });
    };

    previousButton.addEventListener('click', () => scrollOneCard(-1));
    nextButton.addEventListener('click', () => scrollOneCard(1));
    staffCarousel.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
        event.preventDefault();
        scrollOneCard(event.key === 'ArrowLeft' ? -1 : 1);
      }
    });
    staffCarousel.addEventListener('scroll', updateCarousel, { passive: true });

    const initializeCarousel = () => {
      measureCarousel();
      staffCarousel.style.scrollBehavior = 'auto';
      staffCarousel.scrollLeft = setWidth;
      staffCarousel.style.removeProperty('scroll-behavior');
      updateCenteredCard();
    };

    window.addEventListener('resize', initializeCarousel);
    window.requestAnimationFrame(initializeCarousel);
  }
</script>
