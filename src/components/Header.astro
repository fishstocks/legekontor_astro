---
import Logo from './Logo.astro';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const items = [
  { href: '/', label: 'Forside' },
  { href: '/ansatte/', label: 'Ansatte' },
  { href: '/tjenester-og-priser/', label: 'Priser' },
  { href: '/skjema/', label: 'Skjema' },
  { href: '/praktisk-informasjon/', label: 'Praktisk informasjon' },
  { href: '/#kontakt', label: 'Kontakt' },
];

const isCurrent = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="site-header" data-site-header>
  <div class="shell site-header__inner">
    <a class="site-header__logo" href="/">
      <Logo />
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="hovedmeny"
      data-menu-toggle
    >
      <span class="menu-toggle__label">Meny</span>
      <span class="menu-toggle__icon" aria-hidden="true">
        <span></span><span></span>
      </span>
    </button>

    <nav class="site-nav" id="hovedmeny" aria-label="Hovedmeny" data-menu>
      <ul>
        {
          items.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a
        class="button button--small site-nav__cta"
        href="https://minhelse.helsenorge.no/"
        target="_blank"
        rel="noreferrer"
        aria-label="Bestill time på Helsenorge (åpnes i ny fane)"
      >
        Bestill time
      </a>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector('[data-site-header]');
  const toggle = header?.querySelector('[data-menu-toggle]');
  const menu = header?.querySelector('[data-menu]');

  if (header instanceof HTMLElement) {
    const updateScrollState = () => {
      header.toggleAttribute('data-scrolled', window.scrollY > 12);
    };

    updateScrollState();
    window.addEventListener('scroll', updateScrollState, { passive: true });
  }

  if (toggle instanceof HTMLButtonElement && menu instanceof HTMLElement) {
    const closeMenu = () => {
      toggle.setAttribute('aria-expanded', 'false');
      menu.removeAttribute('data-open');
      document.body.classList.remove('menu-is-open');
    };

    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isOpen));
      menu.toggleAttribute('data-open', !isOpen);
      document.body.classList.toggle('menu-is-open', !isOpen);
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });

    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        closeMenu();
        toggle.focus();
      }
    });
  }
</script>
