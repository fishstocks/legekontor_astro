---
import type { ExternalResource } from '../data/clinic';

interface Props {
  resource: ExternalResource;
}

const { resource } = Astro.props;
---

<a class="resource-card" href={resource.href}>
  <span
    class:list={[
      'resource-card__logo',
      { 'resource-card__logo--wide': resource.logoStyle === 'wide' },
    ]}
  >
    <img
      src={resource.logo}
      alt={resource.logoAlt}
      width="150"
      height="52"
      loading="lazy"
      decoding="async"
    />
  </span>
  <span class="resource-card__copy">
    <strong>{resource.name}</strong>
    <span>{resource.description}</span>
  </span>
  <span class="resource-card__arrow link-arrow-ring" aria-hidden="true">→</span>
</a>
