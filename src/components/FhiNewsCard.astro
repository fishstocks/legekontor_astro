---
import type { FhiNewsItem } from '../data/clinic';

interface Props {
  item: FhiNewsItem;
}

const { item } = Astro.props;
---

<article class="fhi-news-card">
  <a href={item.href}>
    <span class="fhi-news-card__meta">
      <span>{item.category}</span>
      <time>{item.date}</time>
    </span>
    <h3>{item.title}</h3>
    <p>{item.summary}</p>
    <span class="fhi-news-card__link">
      <span class="visually-hidden">Les hos FHI</span>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M5 12h14M13 6l6 6-6 6"></path>
      </svg>
    </span>
  </a>
</article>
